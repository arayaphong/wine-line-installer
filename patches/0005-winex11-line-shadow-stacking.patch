diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -456,6 +456,25 @@
     return cached;
 }

+static BOOL is_line_shadow_window( HWND hwnd, DWORD style, DWORD ex_style )
+{
+    static const WCHAR side[] = u"shadow_side_", corner[] = u"shadow_corner_";
+    WCHAR class_name[64];
+    UNICODE_STRING name = {.Buffer = class_name, .MaximumLength = sizeof(class_name)};
+    const WCHAR *suffix, *digits;
+
+    if (!(style & WS_POPUP) || !(ex_style & WS_EX_TOOLWINDOW) || is_virtual_desktop()) return FALSE;
+    if (!NtUserGetClassName( hwnd, FALSE, &name )) return FALSE;
+
+    if (!wcsncmp( class_name, side, ARRAY_SIZE(side) - 1 )) suffix = class_name + ARRAY_SIZE(side) - 1;
+    else if (!wcsncmp( class_name, corner, ARRAY_SIZE(corner) - 1 )) suffix = class_name + ARRAY_SIZE(corner) - 1;
+    else return FALSE;
+    for (digits = suffix; *suffix >= '0' && *suffix <= '9'; ++suffix) ;
+    if (suffix == digits || suffix[0] != '_' || suffix[1] < '0' || suffix[1] > '3' || suffix[2]) return FALSE;
+
+    return X11DRV_HasWindowManager( "Mutter" ) && X11DRV_HasWindowManager( "xwayland" );
+}
+

 /***********************************************************************
  *		is_window_managed
@@ -488,6 +507,10 @@
     /* application windows are managed */
     ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
     if (ex_style & WS_EX_APPWINDOW) return TRUE;
+
+    /* LINE assigns the owner after creation. Let Mutter stack these shadow
+     * popups with that owner when they are mapped. */
+    if (is_line_shadow_window( hwnd, style, ex_style )) return TRUE;
     /* windows that own popups are managed */
     if (has_owned_popups( hwnd )) return TRUE;
     /* default: not managed */
@@ -1672,7 +1695,7 @@
     ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
     if (data->force_below_hack)
         new_state |= (1 << NET_WM_STATE_BELOW);
-    else if ((ex_style & WS_EX_TOPMOST) &&
+    else if ((ex_style & WS_EX_TOPMOST) && !is_line_shadow_window( data->hwnd, style, ex_style ) &&
         /* This workaround was initially targetting some mutter and KDE issues, but
          * removing it causes failure to focus out from exclusive fullscreen windows.
          *
