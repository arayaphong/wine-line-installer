+static BOOL member_tag_matches_hash(const WCHAR *tag, const BYTE *hash, DWORD len)
+{
+    static const WCHAR hex[] = L"0123456789ABCDEF";
+    DWORD i;
+
+    if (!tag || lstrlenW(tag) != len * 2) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        if (tag[i * 2] != hex[hash[i] >> 4]) return FALSE;
+        if (tag[i * 2 + 1] != hex[hash[i] & 0xf]) return FALSE;
+    }
+    return TRUE;
+}
