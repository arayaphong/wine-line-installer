# Local handoff, Wine prefixes, and third-party source and tools.
/HANDOFF.md
/baseline/
/tools/
/wine-src/*
!/wine-src/out/
/wine-src/out/*
!/wine-src/out/SHA256SUMS

# Downloads and generated installers. Keep the checksums used to reproduce them.
*.[eE][xX][eE]
*.[dD][lL][lL]
*.[cC][aA][tT]
*.cab
*.deb
*.msu
*.msix
*.wim
*.iso
*.ttf
*.ttc
*.otf
*.zip
*.7z
*.tar
*.tar.*
*.zst
*.run
!*.sha256
/ms-dlls/source/
/offline/phase1/*.source-*.json
/offline/phase4/thai-fonts/OFL.txt

# Keep the recorded validation summaries and public test screenshots.
*.log
*.rea.json
*.reg
*.xwd
/analysis/*
!/analysis/NOTES.md
!/analysis/diff-preinstall-vs-postinstall.txt
!/analysis/fresh-rebuild-20261127.log
!/analysis/fresh-login-readiness-20261127.log
!/analysis/line-emoji-color-patch-20261126.png
!/analysis/line-emoji-qt-directwrite-20261126.png
!/analysis/line-emoji-qt-native-20261126.png
!/offline/phase1/debian-base-validation.log
!/offline/phase2/standalone-wine-validation.log
!/offline/phase3/debian-line-validation.log
!/offline/phase3/line-launch-trace.log
!/offline/phase4/thai-font-validation.log
!/offline/phase4/line-launch-trace.log
!/offline/phase5/debian-offline-validation.log
!/offline/phase6/clean-debian-validation.log

__pycache__/
.venv/
.build.*/
.payload-*/
